<?xml version="1.0" encoding="utf-8"?>
<!--
    The glowing app icon (brand/firn-app-icon.svg), rendered per density as two
    bitmap layers because vector drawables can't blur. Monochrome (themed icons)
    stays the flat small mark: the system tints it a single colour anyway.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_firn_mark_adaptive" />
</adaptive-icon>
